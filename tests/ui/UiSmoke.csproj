<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UiSmoke</AssemblyName>
    <ClassIslandDir Condition="'$(ClassIslandDir)' == ''">$(CLASSISLAND_DIR)</ClassIslandDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Leaf5049.RandomDraw">
      <HintPath>..\..\src\bin\Release\net8.0\Leaf5049.RandomDraw.dll</HintPath>
    </Reference>
    <Reference Include="ClassIsland.Core"><HintPath>$(ClassIslandDir)\ClassIsland.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="ClassIsland.Shared"><HintPath>$(ClassIslandDir)\ClassIsland.Shared.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="CommunityToolkit.Mvvm"><HintPath>$(ClassIslandDir)\CommunityToolkit.Mvvm.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Avalonia"><HintPath>$(ClassIslandDir)\Avalonia.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Avalonia.Base"><HintPath>$(ClassIslandDir)\Avalonia.Base.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Avalonia.Controls"><HintPath>$(ClassIslandDir)\Avalonia.Controls.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Avalonia.Desktop"><HintPath>$(ClassIslandDir)\Avalonia.Desktop.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Avalonia.Win32"><HintPath>$(ClassIslandDir)\Avalonia.Win32.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Avalonia.Skia"><HintPath>$(ClassIslandDir)\Avalonia.Skia.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <Target Name="CheckClassIslandDir" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ClassIslandDir)' == ''" Text="请先设置环境变量 CLASSISLAND_DIR，指向 ClassIsland 安装目录（目录里应有 ClassIsland.Core.dll）。" />
  </Target>

  <ItemGroup>
    <None Include="$(ClassIslandDir)\libSkiaSharp.dll" Link="libSkiaSharp.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(ClassIslandDir)\SkiaSharp.dll" Link="SkiaSharp.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(ClassIslandDir)\ShimSkiaSharp.dll" Link="ShimSkiaSharp.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

</Project>